    "/api/v1/trips/{id}/days/{n}/regenerate": {
      "post": {
        "tags": [
          "trips"
        ],
        "summary": "Regenerate Trip Day",
        "description": "Regenerate a single day with AI using other days as context to avoid duplicates.",
        "operationId": "regenerate_trip_day_api_v1_trips__id__days__n__regenerate_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Id"
            }
          },
          {
            "name": "n",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "N"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegenerateDayRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
