        ],
        "summary": "Update Trip Day",
        "description": "Manually edit day activities, recomputing est_cost.",
        "operationId": "update_trip_day_api_v1_trips__id__days__n__patch",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "id",
