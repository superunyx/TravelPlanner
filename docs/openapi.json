                "schema": {
                  "$ref": "#/components/schemas/DayRecord"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/trips/{id}/members": {
      "post": {
        "tags": [
          "trips"
        ],
        "summary": "Add Trip Member",
        "description": "Add a group member to a trip by email (owner only).",
        "operationId": "add_trip_member_api_v1_trips__id__members_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddMemberRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/trips/{id}/members/{user_id}": {
      "delete": {
        "tags": [
          "trips"
        ],
        "summary": "Remove Trip Member",
        "description": "Remove a group member from a trip (owner only).",
        "operationId": "remove_trip_member_api_v1_trips__id__members__user_id__delete",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Id"
            }
          },
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "User Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/trips/{id}/summary": {
      "get": {
        "tags": [
          "trips"
        ],
        "summary": "Get Trip Summary",
        "description": "Get cost and budget breakdown by category for a trip.",
        "operationId": "get_trip_summary_api_v1_trips__id__summary_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TripSummaryResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Accommodation": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "area": {
            "type": "string",
            "title": "Area"
          },
          "price_per_night": {
            "type": "number",
            "minimum": 0.0,
            "title": "Price Per Night",
            "default": 0.0
          },
          "why": {
            "type": "string",
            "title": "Why"
          }
        },
        "type": "object",
        "required": [
          "name",
          "area",
          "why"
        ],
        "title": "Accommodation"
      },
      "Activity": {
        "properties": {
          "time_slot": {
            "type": "string",
            "enum": [
              "morning",
              "afternoon",
              "evening",
              "night"
            ],
            "title": "Time Slot"
          },
          "start_time": {
            "type": "string",
            "title": "Start Time"
          },
          "end_time": {
            "type": "string",
            "title": "End Time"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "type": {
            "type": "string",
            "enum": [
              "attraction",
              "dining",
              "transport",
              "stay",
              "activity"
            ],
            "title": "Type"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "location": {
            "type": "string",
            "title": "Location"
          },
          "est_cost": {
            "type": "number",
            "minimum": 0.0,
            "title": "Est Cost",
            "default": 0.0
          },
          "travel_time_from_previous_min": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Travel Time From Previous Min",
            "default": 0
          },
          "tips": {
            "type": "string",
            "title": "Tips",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "time_slot",
          "start_time",
          "end_time",
          "title",
          "type",
          "description",
          "location"
        ],
        "title": "Activity"
      },
      "AddMemberRequest": {
        "properties": {
          "email": {
            "type": "string",
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
            "title": "Email",
            "examples": [
              "partner@example.com"
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "editor",
              "viewer"
            ],
            "title": "Role",
            "default": "editor",
            "examples": [
              "editor"
            ]
          }
        },
        "type": "object",
        "required": [
          "email"
        ],
        "title": "AddMemberRequest"
      },
      "CategoryCostBreakdown": {
        "properties": {
          "category": {
            "type": "string",
            "title": "Category"
          },
          "total_cost": {
            "type": "number",
            "title": "Total Cost"
          },
          "percentage": {
            "type": "number",
            "title": "Percentage"
          }
        },
        "type": "object",
        "required": [
          "category",
          "total_cost",
          "percentage"
        ],
        "title": "CategoryCostBreakdown"
      },
      "CreateTripRequest": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Title",
            "examples": [
              "Golden Triangle Highlights"
            ]
          },
          "destination": {
            "type": "string",
            "maxLength": 120,
            "minLength": 2,
            "title": "Destination",
            "examples": [
              "Jaipur, India"
            ]
          },
          "start_date": {
            "type": "string",
            "format": "date",
            "title": "Start Date",
            "examples": [
              "2026-11-10"
            ]
          },
          "end_date": {
            "type": "string",
            "format": "date",
            "title": "End Date",
            "examples": [
              "2026-11-14"
            ]
          },
          "budget": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Budget",
            "examples": [
              50000.0
            ]
          },
          "currency": {
            "type": "string",
            "maxLength": 5,
            "minLength": 3,
            "title": "Currency",
            "default": "INR",
            "examples": [
              "INR"
            ]
          },
          "travel_style": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Travel Style",
            "default": "balanced",
            "examples": [
              "cultural"
            ]
          },
          "pacing": {
            "type": "string",
            "enum": [
              "relaxed",
              "moderate",
              "packed"
            ],
            "title": "Pacing",
            "default": "moderate",
            "examples": [
              "moderate"
            ]
          },
          "group_size": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Group Size",
            "default": 2,
            "examples": [
              2
            ]
          },
          "interests": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Interests",
            "examples": [
              [
                "architecture",
                "food",
                "history"
              ]
            ]
          },
          "preferences": {
            "additionalProperties": true,
            "type": "object",
            "title": "Preferences",
            "examples": [
              {
                "diet": "vegetarian"
              }
            ]
          },
          "stay": {
            "additionalProperties": true,
            "type": "object",
            "title": "Stay"
          }
        },
        "type": "object",
        "required": [
          "title",
          "destination",
          "start_date",
          "end_date",
          "budget"
        ],
        "title": "CreateTripRequest"
      },
      "DayPlan": {
        "properties": {
          "day_number": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Day Number"
          },
          "date": {
            "type": "string",
            "title": "Date"
          },
          "theme": {
            "type": "string",
            "title": "Theme"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "activities": {
            "items": {
              "$ref": "#/components/schemas/Activity"
            },
            "type": "array",
            "title": "Activities"
          },
          "day_total_cost": {
            "type": "number",
            "minimum": 0.0,
            "title": "Day Total Cost",
            "default": 0.0
          }
        },
        "type": "object",
        "required": [
          "day_number",
          "date",
          "theme",
          "summary"
        ],
        "title": "DayPlan"
      },
      "DayRecord": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "trip_id": {
            "type": "string",
            "format": "uuid",
            "title": "Trip Id"
          },
          "day_number": {
            "type": "integer",
            "title": "Day Number"
          },
          "date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Date"
          },
          "summary": {
            "type": "string",
            "title": "Summary",
            "default": ""
          },
          "items": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Items"
          },
          "est_cost": {
            "type": "number",
            "title": "Est Cost",
            "default": 0.0
          }
        },
        "type": "object",
        "required": [
          "id",
          "trip_id",
          "day_number"
        ],
        "title": "DayRecord"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthResponse"
      },
      "Itinerary": {
        "properties": {
          "destination": {
            "type": "string",
            "title": "Destination"
          },
          "days": {
            "items": {
              "$ref": "#/components/schemas/DayPlan"
            },
            "type": "array",
            "title": "Days"
          },
          "accommodation": {
            "$ref": "#/components/schemas/Accommodation"
          },
          "total_estimated_cost": {
            "type": "number",
            "minimum": 0.0,
            "title": "Total Estimated Cost",
            "default": 0.0
          },
          "budget_status": {
            "type": "string",
            "enum": [
              "under_budget",
              "on_budget",
              "over_budget"
            ],
            "title": "Budget Status",
            "default": "on_budget"
          },
          "packing_tips": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Packing Tips"
          }
        },
        "type": "object",
        "required": [
